      ],
      "html": "<div class=\"flex flex-wrap items-center gap-2\">\n  <button class=\"btn\">Save changes</button>\n  <button class=\"btn btn-soft\">Soft</button>\n  <button class=\"btn btn-outline\">Outline</button>\n  <button class=\"btn btn-ghost\">Ghost</button>\n  <button class=\"btn btn-link\">Link</button>\n  <button class=\"btn btn-dashed\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg> Add item</button>\n  <button class=\"btn btn-gradient\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8\"/></svg> Upgrade</button>\n</div>\n<div class=\"flex flex-wrap items-center gap-2 mt-3\">\n  <button class=\"btn btn-secondary\">Secondary</button>\n  <button class=\"btn btn-accent\">Accent</button>\n  <button class=\"btn btn-neutral\">Neutral</button>\n  <button class=\"btn btn-success\">Success</button>\n  <button class=\"btn btn-warning\">Warning</button>\n  <button class=\"btn btn-danger\">Danger</button>\n  <button class=\"btn btn-info\">Info</button>\n</div>\n<div class=\"flex flex-wrap items-center gap-2 mt-3\">\n  <button class=\"btn btn-xs\">Extra small</button>\n  <button class=\"btn btn-sm\">Small</button>\n  <button class=\"btn btn-md\">Medium</button>\n  <button class=\"btn btn-lg\">Large</button>\n  <button class=\"btn btn-xl\">Extra large</button>\n</div>\n<div class=\"flex flex-wrap items-center gap-2 mt-3\">\n  <button class=\"btn btn-outline btn-neutral btn-active\">Active</button>\n  <button class=\"btn\" disabled>Disabled</button>\n  <a class=\"btn btn-soft btn-disabled\" href=\"#\" aria-disabled=\"true\">Disabled link</a>\n  <button class=\"btn btn-loading\" aria-busy=\"true\">Saving</button>\n  <button class=\"btn btn-danger btn-soft\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"/></svg> Delete</button>\n</div>"
    },
    {
      "name": "Button shapes",
      "slug": "button-shapes",
      "description": "Square, circle, pill, full width and wide buttons, plus a quiet icon only button.",
      "classes": [
        "btn-square",
        "btn-circle",
        "btn-pill",
        "btn-block",
        "btn-wide",
        "btn-icon"
      ],
      "html": "<div class=\"flex flex-wrap items-center gap-2\">\n  <button class=\"btn btn-square\" aria-label=\"Add\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></button>\n  <button class=\"btn btn-circle btn-outline\" aria-label=\"Like\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z\"/></svg></button>\n  <button class=\"btn btn-pill btn-soft\">Pill button</button>\n  <button class=\"btn btn-wide btn-neutral\">Wide</button>\n  <button class=\"btn btn-icon\" aria-label=\"Edit\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z\"/></svg></button>\n  <button class=\"btn btn-icon btn-danger\" aria-label=\"Delete\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"/></svg></button>\n</div>\n<button class=\"btn btn-block mt-3\">Continue to checkout</button>"
    },
    {
      "name": "Button group",
      "slug": "button-group",
      "description": "Joined controls that share borders, horizontally or vertically, and a toolbar that spaces groups apart.",
      "classes": [
        "btn-group",
        "btn-group-vertical",
        "join",
        "join-vertical",
        "btn-toolbar"
      ],
      "html": "<div class=\"btn-toolbar\" role=\"toolbar\" aria-label=\"Editor\">\n  <div class=\"btn-group\" role=\"group\" aria-label=\"History\">\n    <button class=\"btn btn-outline btn-neutral btn-sm\">Undo</button>\n    <button class=\"btn btn-outline btn-neutral btn-sm\">Redo</button>\n  </div>\n  <div class=\"join\">\n    <button class=\"btn btn-sm\">Day</button>\n    <button class=\"btn btn-sm btn-active\">Week</button>\n    <button class=\"btn btn-sm\">Month</button>\n  </div>\n  <div class=\"join\">\n    <button class=\"btn btn-outline btn-neutral btn-sm btn-square\" aria-label=\"Previous\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"/></svg></button>\n    <button class=\"btn btn-outline btn-neutral btn-sm\">Page 2</button>\n    <button class=\"btn btn-outline btn-neutral btn-sm btn-square\" aria-label=\"Next\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></button>\n  </div>\n</div>\n<div class=\"flex gap-4 mt-3\">\n  <div class=\"join-vertical\">\n    <button class=\"btn btn-soft\">Top</button>\n    <button class=\"btn btn-soft\">Middle</button>\n    <button class=\"btn btn-soft\">Bottom</button>\n  </div>\n  <div class=\"btn-group-vertical\">\n    <button class=\"btn btn-outline\">First</button>\n    <button class=\"btn btn-outline\">Second</button>\n  </div>\n</div>"
    },
    {
      "name": "Floating action button",
      "slug": "fab",
      "description": "A floating action button whose speed dial opens on hover or keyboard focus, with no script.",
      "classes": [
        "fab",
        "fab-trigger",
        "fab-actions",
        "fab-action",
        "fab-label",
        "fab-start",
        "fab-center",
        "fab-contained",
        "fab-open"
      ],
      "html": "<div class=\"relative h-64 rounded-xl border bg-muted overflow-hidden\">\n  <div class=\"fab fab-contained\">\n    <button class=\"btn btn-circle btn-lg fab-trigger\" aria-label=\"Create\"><svg class=\"size-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></button>\n    <div class=\"fab-actions\">\n      <div class=\"fab-action\"><span class=\"fab-label\">New note</span><button class=\"btn btn-circle btn-soft\" aria-label=\"New note\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z\"/></svg></button></div>\n      <div class=\"fab-action\"><span class=\"fab-label\">Upload image</span><button class=\"btn btn-circle btn-soft\" aria-label=\"Upload image\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"9\" cy=\"9\" r=\"2\"/><path d=\"m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21\"/></svg></button></div>\n      <div class=\"fab-action\"><span class=\"fab-label\">Share</span><button class=\"btn btn-circle btn-soft\" aria-label=\"Share\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"18\" cy=\"5\" r=\"3\"/><circle cx=\"6\" cy=\"12\" r=\"3\"/><circle cx=\"18\" cy=\"19\" r=\"3\"/><path d=\"m8.6 13.5 6.8 4M15.4 6.5l-6.8 4\"/></svg></button></div>\n    </div>\n  </div>\n  <div class=\"fab fab-contained fab-start fab-open\">\n    <button class=\"btn btn-circle btn-neutral fab-trigger\" aria-label=\"Menu\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></button>\n    <div class=\"fab-actions\">\n      <div class=\"fab-action\"><span class=\"fab-label\">Always open</span><button class=\"btn btn-circle btn-sm btn-outline btn-neutral\" aria-label=\"Mail\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/><path d=\"m22 7-10 6L2 7\"/></svg></button></div>\n    </div>\n  </div>\n</div>"
    },
    {
      "name": "Copy button",
      "slug": "copy-button",
      "description": "A compact button for copying code or links, with a confirmed state.",
      "classes": [
        "copy-btn",
        "copy-btn-done"
      ],
      "html": "<div class=\"flex items-center gap-2\">\n  <button class=\"copy-btn\" type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg> Copy</button>\n  <button class=\"copy-btn copy-btn-done\" type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg> Copied</button>\n  <button class=\"copy-btn\" type=\"button\" aria-label=\"Copy link\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg></button>\n</div>"
    },
    {
      "name": "Segmented control",
      "slug": "segmented",
      "description": "A single choice control built from radio inputs, keyboard friendly by default.",
      "classes": [
        "segmented",
        "segmented-item",
        "segmented-xs",
        "segmented-sm",
        "segmented-md",
        "segmented-lg",
        "segmented-xl",
        "segmented-block"
      ],
      "html": "<div class=\"flex flex-wrap items-center gap-3\"><div class=\"segmented\" role=\"radiogroup\" aria-label=\"Range\">\n  <label class=\"segmented-item\"><input type=\"radio\" name=\"range\" checked> Day</label>\n  <label class=\"segmented-item\"><input type=\"radio\" name=\"range\"> Week</label>\n  <label class=\"segmented-item\"><input type=\"radio\" name=\"range\"> Month</label>\n  <label class=\"segmented-item\"><input type=\"radio\" name=\"range\" disabled> Year</label>\n</div>\n<div class=\"segmented segmented-sm mt-3\" role=\"radiogroup\" aria-label=\"View\">\n  <label class=\"segmented-item\"><input type=\"radio\" name=\"view\" checked><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01\"/></svg> List</label>\n  <label class=\"segmented-item\"><input type=\"radio\" name=\"view\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg> Grid</label>\n</div>\n<div class=\"segmented segmented-block segmented-lg mt-3\" role=\"radiogroup\" aria-label=\"Plan\">\n  <label class=\"segmented-item\"><input type=\"radio\" name=\"plan\"> Monthly</label>\n  <label class=\"segmented-item\"><input type=\"radio\" name=\"plan\" checked> Yearly</label>\n</div></div>"
    },
    {
      "name": "Toggle group",
      "slug": "toggle-group",
      "description": "A row of joined toggles built from checkboxes, so several can be on at once.",
      "classes": [
        "toggle-group",
        "toggle-group-item",
        "toggle-group-vertical",
        "toggle-group-xs",
        "toggle-group-sm",
        "toggle-group-md",
        "toggle-group-lg",
        "toggle-group-xl"
      ],
      "html": "<div class=\"flex flex-wrap items-center gap-3\"><div class=\"toggle-group\" role=\"group\" aria-label=\"Text style\">\n  <label class=\"toggle-group-item\" aria-label=\"Bold\"><input type=\"checkbox\" checked><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 12h9a4 4 0 0 1 0 8H6V4h8a4 4 0 0 1 0 8\"/></svg></label>\n  <label class=\"toggle-group-item\" aria-label=\"Italic\"><input type=\"checkbox\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M19 4h-9M14 20H5M15 4 9 20\"/></svg></label>\n  <label class=\"toggle-group-item\" aria-label=\"Underline\"><input type=\"checkbox\" checked><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 4v6a6 6 0 0 0 12 0V4M4 20h16\"/></svg></label>\n</div>\n<div class=\"toggle-group toggle-group-sm mt-3\" role=\"group\" aria-label=\"Days\">\n  <label class=\"toggle-group-item\"><input type=\"checkbox\" checked> Mon</label>\n  <label class=\"toggle-group-item\"><input type=\"checkbox\"> Tue</label>\n  <label class=\"toggle-group-item\"><input type=\"checkbox\" checked> Wed</label>\n  <label class=\"toggle-group-item\"><input type=\"checkbox\"> Thu</label>\n</div></div>"
    },
    {
      "name": "Swap",
      "slug": "swap",
      "description": "Swaps two pieces of content when its checkbox is checked, with fade, rotate, scale and flip effects.",
      "classes": [
        "swap",
        "swap-on",
        "swap-off",
        "swap-active",
        "swap-rotate",
        "swap-scale",
        "swap-flip"
      ],
      "html": "<div class=\"flex items-center gap-4\">\n  <label class=\"swap swap-rotate btn btn-icon\" aria-label=\"Toggle theme\">\n    <input type=\"checkbox\">\n    <span class=\"swap-on\"><svg class=\"size-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\"/></svg></span>\n    <span class=\"swap-off\"><svg class=\"size-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg></span>\n  </label>\n  <label class=\"swap swap-scale btn btn-icon\" aria-label=\"Toggle menu\">\n    <input type=\"checkbox\" checked>\n    <span class=\"swap-on\"><svg class=\"size-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></span>\n    <span class=\"swap-off\"><svg class=\"size-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg></span>\n  </label>\n  <label class=\"swap swap-flip text-3xl\">\n    <input type=\"checkbox\">\n    <span class=\"swap-on\">ON</span>\n    <span class=\"swap-off\">OFF</span>\n  </label>\n  <span class=\"swap swap-active font-semibold\"><span class=\"swap-on\">Saved</span><span class=\"swap-off\">Saving</span></span>\n</div>"
    },
    {
      "name": "Alert",
      "slug": "alert",
      "description": "Inline messages in soft, outline and solid styles with an icon, title, description, actions and a script free dismiss.",
      "classes": [
        "alert",
        "alert-icon",
        "alert-content",
        "alert-title",
        "alert-description",
        "alert-actions",
        "alert-primary",
        "alert-secondary",
        "alert-accent",
        "alert-neutral",
        "alert-success",
        "alert-warning",
        "alert-danger",
        "alert-info",
        "alert-soft",
        "alert-outline",
        "alert-solid",
        "dismiss",
        "dismissible"
      ],
      "html": "<div class=\"space-y-3\">\n  <div class=\"alert alert-info\" role=\"status\">\n    <svg class=\"alert-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 16v-4M12 8h.01\"/></svg>\n    <div class=\"alert-content\">\n      <p class=\"alert-title\">Update available</p>\n      <p class=\"alert-description\">Version 2.4 adds offline sync and faster search.</p>\n    </div>\n    <div class=\"alert-actions\"><button class=\"btn btn-sm btn-info\">Update</button></div>\n  </div>\n  <div class=\"alert alert-success alert-outline\" role=\"status\">\n    <svg class=\"alert-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m8.5 12 2.5 2.5 4.5-5\"/></svg>\n    <div class=\"alert-content\"><p class=\"alert-title\">Payment received</p><p class=\"alert-description\">Invoice 1042 was paid in full.</p></div>\n    <details class=\"dismiss\" open><summary aria-label=\"Dismiss\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></summary></details>\n  </div>\n  <div class=\"alert alert-warning\" role=\"alert\">\n    <svg class=\"alert-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z\"/><path d=\"M12 9v4M12 17h.01\"/></svg>\n    <div class=\"alert-content\"><p class=\"alert-title\">Your trial ends in 3 days</p></div>\n    <details class=\"dismiss\" open><summary aria-label=\"Dismiss\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></summary></details>\n  </div>\n  <div class=\"alert alert-danger alert-solid\" role=\"alert\">\n    <svg class=\"alert-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 8v4M12 16h.01\"/></svg>\n    <div class=\"alert-content\"><p class=\"alert-title\">Deployment failed</p><p class=\"alert-description\">The build step exited with code 1.</p></div>\n    <details class=\"dismiss\" open><summary aria-label=\"Dismiss\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></summary></details>\n  </div>\n  <div class=\"alert\">\n    <svg class=\"alert-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/><path d=\"M10.3 21a1.9 1.9 0 0 0 3.4 0\"/></svg>\n    <div class=\"alert-content\">A neutral alert with only a description.</div>\n  </div>\n  <div class=\"dismissible flex items-center justify-between gap-2 rounded-lg border p-3 text-sm\">Any element can be dismissed. <details class=\"dismiss\" open><summary aria-label=\"Dismiss\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></summary></details></div>\n</div>"
    },
    {
      "name": "Callout",
      "slug": "callout",
      "description": "A highlighted note for documentation and long form content.",
      "classes": [
        "callout",
        "callout-title",
        "callout-primary",
        "callout-secondary",
        "callout-accent",
        "callout-neutral",
        "callout-success",
        "callout-warning",
        "callout-danger",
        "callout-info"
      ],
      "html": "<div class=\"space-y-3\">\n  <div class=\"callout\">\n    <p class=\"callout-title\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 16v-4M12 8h.01\"/></svg> Note</p>\n    <p>Theme tokens follow the seed color, so callouts match your brand.</p>\n  </div>\n  <div class=\"callout callout-warning\">\n    <p class=\"callout-title\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z\"/><path d=\"M12 9v4M12 17h.01\"/></svg> Heads up</p>\n    <p>This setting affects every project in the workspace.</p>\n  </div>\n  <div class=\"callout callout-success\"><p class=\"callout-title\">Tip</p><p>Press <kbd class=\"kbd kbd-sm\">/</kbd> to search.</p></div>\n</div>"
    },
    {
      "name": "Banner",
      "slug": "banner",
      "description": "A full width announcement bar for the top of the page, solid, soft or gradient.",
      "classes": [
        "banner",
        "banner-link",
        "banner-soft",
