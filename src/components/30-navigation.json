    {
      "name": "Drawer dialog",
      "slug": "drawer-dialog",
      "description": "A modal side panel built on <dialog>, opened with command=\"show-modal\" and closed with command=\"close\" or a click outside (closedby=\"any\"). Slides in from any edge.",
