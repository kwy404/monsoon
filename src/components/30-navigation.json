    {
      "name": "Responsive drawer",
      "slug": "drawer-responsive",
      "description": "An app shell whose drawer is a toggled overlay on small screens and a sticky, always open sidebar from the lg breakpoint.",
      "classes": [
        "drawer-open-lg"
      ],
      "html": "<div class=\"drawer drawer-open-lg\"><input id=\"app-drawer\" type=\"checkbox\" class=\"drawer-toggle\"><main class=\"drawer-content p-6\"><label for=\"app-drawer\" class=\"inline-flex items-center justify-center gap-2 rounded-lg border border-border bg-surface px-4 py-2 text-sm font-medium hover:bg-muted cursor-pointer lg:hidden\">Menu</label><h1 class=\"mt-4 text-2xl font-semibold\">Overview</h1></main><div class=\"drawer-side\"><label for=\"app-drawer\" class=\"drawer-overlay\" aria-label=\"Close menu\"></label><nav class=\"drawer-panel\" aria-label=\"App\"><ul class=\"menu\"><li><a href=\"#\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z\"/></svg>Overview</a></li><li><a href=\"#\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 3v18h18\"/><path d=\"m7 15 4-4 3 3 5-6\"/></svg>Reports</a></li><li><a href=\"#\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2v3M12 19v3M4.9 4.9 7 7M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1\"/></svg>Settings</a></li></ul></nav></div></div>"
    },
