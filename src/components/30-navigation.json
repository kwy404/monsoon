      "html": "<button type=\"button\" commandfor=\"cart-drawer\" command=\"show-modal\" class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:opacity-90\">Open cart</button><dialog id=\"cart-drawer\" class=\"drawer-dialog drawer-end\" closedby=\"any\" aria-labelledby=\"cart-title\"><h2 id=\"cart-title\" class=\"text-lg font-semibold\">Your cart</h2><button type=\"button\" commandfor=\"cart-drawer\" command=\"close\" class=\"modal-close\" aria-label=\"Close\"></button><ul class=\"flex flex-col gap-3 text-sm\"><li class=\"flex justify-between\"><span>Linen shirt</span><span class=\"font-medium\">$48</span></li><li class=\"flex justify-between\"><span>Canvas tote</span><span class=\"font-medium\">$22</span></li></ul><button type=\"button\" class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:opacity-90 mt-auto w-full\">Checkout</button></dialog>"
